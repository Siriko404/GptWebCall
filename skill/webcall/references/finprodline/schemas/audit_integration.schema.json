{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integrated audit verdict",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "produced_by",
    "replica_reports",
    "findings_register",
    "conflicts",
    "verdict"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "produced_by": {
      "type": "object",
      "required": [
        "worker_id",
        "exchange_id"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "exchange_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replica_reports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "rejected",
              "unresolved_minority"
            ]
          },
          "merged_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition_reason": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "between",
          "issue",
          "resolution"
        ],
        "additionalProperties": true,
        "properties": {
          "between": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "description": "Resolution against authority, or explicitly unresolved."
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ],
      "description": "Pass requires every acceptance criterion mapped by the audit plan to be satisfied, every finding closed, no unadjudicated conflict, and reconciliation passed."
    },
    "repairs_performed": {
      "const": false,
      "description": "An integrator never repairs what it adjudicated."
    }
  }
}
