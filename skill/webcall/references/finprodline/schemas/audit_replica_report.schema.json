{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One auditor replica's report",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "chunk_id",
    "replica_index",
    "produced_by",
    "findings",
    "verdict"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "replica_index": {
      "type": "integer",
      "minimum": 1
    },
    "produced_by": {
      "type": "object",
      "required": [
        "worker_id",
        "exchange_id"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "exchange_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "independent_of": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Replica ids this report did not see."
    },
    "context_completeness_manifest": {
      "type": "object",
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "audit_finding.schema.json"
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "pass_with_notes"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
