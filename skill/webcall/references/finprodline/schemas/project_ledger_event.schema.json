{
  "type": "object",
  "required": [
    "schema_version",
    "seq",
    "event_id",
    "timestamp",
    "actor",
    "event_type",
    "subject_id",
    "payload",
    "evidence_refs",
    "supersedes",
    "prev_event_hash",
    "event_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^project-[0-9]{6}-[0-9a-f]{8}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "pattern": "^(coordinator|terminal|operator|worker:[A-Za-z0-9._:-]+)$"
    },
    "event_type": {
      "enum": [
        "goal_set",
        "operator_ruling_recorded",
        "plan_proposed",
        "plan_accepted",
        "plan_superseded",
        "phase_opened",
        "gate_state_changed",
        "finding_promoted",
        "finding_closed",
        "conclusion_accepted",
        "open_item_raised",
        "open_item_settled",
        "scope_changed",
        "earn_keep_cut_recorded",
        "final_decision"
      ]
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate": {
      "enum": [
        "METHOD",
        "DATA",
        "EXECUTION",
        null
      ]
    },
    "payload": {
      "type": "object",
      "description": "Free-form. The schema deliberately does not pin finance content here."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prev_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
