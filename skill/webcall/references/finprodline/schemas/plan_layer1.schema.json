{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer 1 \u2014 tentative project overview plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "layer",
    "version",
    "produced_by",
    "tentative",
    "audit_state"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "produced_by": {
      "type": "object",
      "required": [
        "worker_id",
        "exchange_id"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "exchange_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tentative": {
      "const": true,
      "description": "Layer 1 is explicitly tentative by definition."
    },
    "audit_state": {
      "enum": [
        "proposed",
        "in_audit",
        "accepted",
        "superseded"
      ]
    },
    "phases": {
      "type": "array",
      "description": "The proposed semantic phases. Content is the planner's own; the schema pins identity and evidence, not the phase design.",
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "title"
        ],
        "additionalProperties": true,
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
